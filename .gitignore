*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.idea/
.vscode/
.venv_test/
graphify-out/
*.iml
storage/storage/

# Edge Storage & Logs (Keep directories, exclude large binary streams/DB)
storage/*.db*
storage/clips/*
storage/snapshots/*
storage/dvr/*
storage/archives/*
storage/backups/*
!storage/backups/.gitkeep
edge_backend/storage/*.db*
edge_backend/storage/clips/*
edge_backend/storage/snapshots/*
edge_backend/storage/dvr/*
edge_backend/storage/archives/*
edge_backend/storage/backups/*
!edge_backend/storage/backups/.gitkeep
*.log

# TLS / Certificates (Secrets)
edge_backend/certs/*.key
edge_backend/certs/*.pem
edge_backend/certs/*.crt
!edge_backend/certs/.gitkeep

# Flutter & Dart
mobile_app/.dart_tool/
mobile_app/.flutter-plugins
mobile_app/.flutter-plugins-dependencies
mobile_app/.packages
mobile_app/.pub-cache/
mobile_app/.pub/
mobile_app/build/

# Android
mobile_app/android/**/gradle-wrapper.jar
mobile_app/android/.gradle
mobile_app/android/captures/
mobile_app/android/gradlew
mobile_app/android/gradlew.bat
mobile_app/android/local.properties
mobile_app/android/**/GeneratedPluginRegistrant.java

# iOS
mobile_app/ios/**/*.mode1v3
mobile_app/ios/**/*.mode2v3
mobile_app/ios/**/*.moved-aside
mobile_app/ios/**/*.pbxuser
mobile_app/ios/**/*.perspectivev3
mobile_app/ios/**/*sync/
mobile_app/ios/**/.sconsign.dblite
mobile_app/ios/**/.tags*
mobile_app/ios/**/.vagrant/
mobile_app/ios/**/DerivedData/
mobile_app/ios/**/Icon?
mobile_app/ios/**/Pods/
mobile_app/ios/**/.symlinks/
mobile_app/ios/**/profile
mobile_app/ios/**/xcuserdata
mobile_app/ios/.generated/
mobile_app/ios/Flutter/App.framework
mobile_app/ios/Flutter/Flutter.framework
mobile_app/ios/Flutter/Flutter.podspec
mobile_app/ios/Flutter/Generated.xcconfig
mobile_app/ios/Flutter/app.flx
mobile_app/ios/Flutter/app.zip
mobile_app/ios/Flutter/flutter_assets/
mobile_app/ios/Flutter/flutter_export_environment.sh
mobile_app/ios/ServiceDefinitions.json
mobile_app/ios/Runner/GeneratedPluginRegistrant.h
mobile_app/ios/Runner/GeneratedPluginRegistrant.m

# Environment Variables & Secrets
.env
.env.local
.env.*
*.env
!.env.example
!**/.env.example

# Machine-local secrets and site state. Each machine generates its own secrets
# (app/services/secret_store.py); none of this may ever be committed.
storage/secrets/
storage/setup_code.txt
storage/setup_code.txt.*
storage/nvr_credentials.json*
storage/*.tmp
storage/.*.tmp
storage/logs/
storage/theft_evidence/
storage/trt_cache/
storage/recordings/
edge_backend/storage/secrets/
edge_backend/storage/setup_code.txt
edge_backend/storage/setup_code.txt.*
edge_backend/storage/nvr_credentials.json*
edge_backend/storage/*.tmp
edge_backend/storage/.*.tmp
edge_backend/storage/logs/
edge_backend/storage/theft_evidence/
edge_backend/storage/trt_cache/
edge_backend/storage/recordings/
# Catch-all: everything else the running system writes under storage/ is
# site data too (zones, shelf layouts, databases). Only .gitkeep is tracked.
storage/*
!storage/backups/
!storage/backups/.gitkeep
edge_backend/storage/*
!edge_backend/storage/backups/
!edge_backend/storage/backups/.gitkeep
# Locally exported / cached models and their bookkeeping
models/.local_exports.json
edge_backend/models/.local_exports.json
# Docker volumes holding node keys / state
edge_backend/tailscale_state/
edge_backend/certs/*
!edge_backend/certs/.gitkeep
# Private keys, keystores and mobile signing / push credentials
*.key
*.pem
*.p8
*.p12
*.pfx
*.jks
*.keystore
mobile_app/android/key.properties
mobile_app/android/app/google-services.json
mobile_app/ios/Runner/GoogleService-Info.plist

# Downloaded tool binaries (cloudflared, fetched by edge_backend/scripts/bootstrap.py)
/bin/

# Model binaries (70-220 MB) are not versioned: models/manifest.json pins each
# file by sha256 and ./run.sh (scripts/fetch_models.py) downloads or re-exports
# them on a fresh machine.
edge_backend/models/*.onnx
edge_backend/models/*.zip
