# Copy to frps.env (chmod 600) next to docker-compose.yml. See README.md.
# The Docker network your reverse proxy is on (docker network ls).
PROXY_NETWORK=proxy
# Where the edge boxes connect (Settings -> Tunnel server = wss://<TUNNEL_HOST>).
TUNNEL_HOST=tunnel.example.com
# Optional shared frp token (openssl rand -hex 32). If set, every box needs it
# as "Server key" in Settings. Per-store tokens are checked by the store check.
FRP_AUTH_TOKEN=
# Traefik only: which names are store dashboards, and your entrypoint / resolver.
PUBLIC_HOST_REGEX=^[a-z0-9-]+-cctv\.example\.com$
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
