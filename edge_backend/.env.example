# Edge AI CCTV -- deployment configuration.
#
# Copy to `.env` beside the application and edit. Never commit `.env`
# (it is git-ignored); only this example file is tracked.

# --- Security -----------------------------------------------------------
# DEBUG makes logging more verbose and serves the API docs (/docs) on the
# local address; it never disables authentication.
# AUTH_DISABLED=true turns authentication off on every API route: isolated
# development machines only, never in a store.
DEBUG=false
AUTH_DISABLED=false

# Secrets: leave these commented out. On first start the app generates a
# random value for each one and keeps it in
#   <STORAGE_DIR>/secrets/device_secrets.json   (directory 0700, file 0600)
# so every machine (dev PC, test box, each store) has its own secrets and none
# of them is ever in the repository. Resolution order: process environment,
# then this .env, then that file. Values containing CHANGE_ME (or the old
# shipped defaults) are ignored and treated as unset.
#
# Set one here only to pin it deliberately (e.g. several app instances behind
# one load balancer). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
# JWT_SECRET=CHANGE_ME             # signs operator sessions
# AUTH_SECRET_KEY=CHANGE_ME        # legacy auth signing key
# INTERNAL_SERVICE_KEY=CHANGE_ME   # X-Edge-API-Key for mobile app / POS bridge
# NVR_CREDENTIAL_KEY=CHANGE_ME     # encrypts NVR passwords in storage/nvr_credentials.json;
#                                  # changing it makes saved NVR passwords unreadable

# Optional TURN relay (docker compose --profile turn). Not needed for the
# online dashboard: remote viewing goes over HTTPS through the remote-access
# tunnel, and WebRTC stays on the store LAN. Only when you run the turn
# profile: set TURN_ENABLED=true, a shared COTURN_SECRET (the coturn
# container refuses to start without one) and the public COTURN_PUBLIC_IP.
TURN_ENABLED=false
# COTURN_SECRET=CHANGE_ME
# COTURN_PUBLIC_IP=203.0.113.10

# Online access (the dashboard through your own VPS) is configured in the
# dashboard: Settings -> Online access (public address, tunnel server, store
# ID, store token, optional server key). The address can be changed there at
# any time (e.g. at handover to the customer's domain). The secrets are stored
# encrypted under storage/secrets, not here. VPS side: deploy/vps/README.md.
# FRPC_PATH overrides where the frpc binary is found (default: PATH, then
# <repo>/bin/frpc, fetched by the installer with EDGE_TUNNEL=1).
# EDGE_TUNNEL_CA_FILE: CA certificate(s) to verify the tunnel server with, only
# for a private CA (default: the system CA bundle).
# API docs (/docs, /redoc, /openapi.json) are served only with DEBUG=true,
# and never through the public hostname.

# Restrict to the addresses that actually serve the dashboard.
# "*" is acceptable only on an isolated VLAN with no internet route.
ALLOWED_CORS_ORIGINS=["http://localhost:8000"]

# --- Store identity -----------------------------------------------------
STORE_ID=store_main
STORE_NAME=Your Store Name
# Starting blueprint extent in metres; editable later in the dashboard.
DEFAULT_STORE_WIDTH_M=50.0
DEFAULT_STORE_HEIGHT_M=30.0

# --- Person detection ---------------------------------------------------
# The accelerator is auto-detected at startup (TensorRT -> CUDA -> MIGraphX
# (AMD) -> OpenVINO -> CPU; a Hailo NPU is reported but has no compatible
# model) and run.sh / deploy/install.sh install the matching onnxruntime
# build. Nothing here selects hardware.
#
# The person model is RTMO-s (mmpose, Apache-2.0; models/manifest.json lists
# every model the product may use, with its licence). Leave these commented
# unless you need to override the choice; the service log line
# "Inference: provider=... model=..." shows what was picked. A ladder lists
# optional larger models (most accurate first) that the service measures and
# steps between by camera count and load; none ships, so it is empty.
# POSE_MODEL_GPU=rtmo-s-body7-640x640-static.onnx
# POSE_MODEL_CPU=rtmo-s-body7-640x640-static.onnx
# POSE_MODEL_LADDER_GPU=
# POSE_MODEL_LADDER_CPU=
# POSE_MODEL_PATH=              # pin one file and skip the ladder
# POSE_REFINER=off             # RTMPose keypoint refiner: off | auto | on (off: no gain on RTMO keypoints)
# POSE_REFINER_MAX_TURN_DEG=45  # discard a refined skeleton turned >45 deg from the pose model's
# POSE_REFINER_MIN_SCORE=0      # per-joint refiner score needed to move a joint (0 = all)
#
# Shadow pose-model trial (developer experiment; services/shadow_trial.py).
# A second pose model runs on frames the live model already analysed and only
# a paired comparison is kept (Settings > System health, and
# GET /api/v1/system/shadow-trial). It never changes counts or alerts. It
# uses at most SHADOW_POSE_SHARE of the accelerator's time and only when the
# live model is not using or waiting for it. Review images of disagreements
# (privacy masks applied, <= SHADOW_SAMPLES_MAX files / SHADOW_SAMPLES_MAX_MB)
# stay in storage/shadow_trial and are deleted SHADOW_TRIAL_RETAIN_DAYS after
# the trial's last data. Empty SHADOW_POSE_MODEL = off (the default); set it
# to a candidate model file listed in models/manifest.json.
# SHADOW_POSE_MODEL=
# SHADOW_POSE_SHARE=0.15
# SHADOW_POSE_CAMERAS=             # camera ids, comma separated; empty = all
# SHADOW_TRIAL_WINDOW=             # local "HH:MM-HH:MM", may cross midnight; empty = always
# SHADOW_SAMPLES_MAX=200
# SHADOW_SAMPLES_MAX_MB=40
# SHADOW_TRIAL_RETAIN_DAYS=7
#
# CPU inference uses half the cores by default so the machine stays usable.
# INFERENCE_CPU_THREADS=0       # 0 = half the CPUs
# AMD GPUs: fp16 is faster but moves boxes/keypoints a few px; unverified on
# real footage, so fp32 is the default.
# MIGRAPHX_FP16=0
# AMD GPUs: the thread waiting for an inference sleeps instead of spinning a
# CPU core (same speed; 5.8 -> 2.8 ms CPU per run measured). 0 = HIP default.
# MIGRAPHX_BLOCKING_SYNC=1

# Raise if the store reports people who are not there; lower if real shoppers
# are missed. Tune against real footage, not a guess.
PERSON_CONF_THRESHOLD=0.50
# A person whose own box is dark (mean luminance < PERSON_DARK_LUMA, 0-255)
# needs only PERSON_CONF_THRESHOLD_DARK: the model is less confident in shade
# and at night for the same person. Box-local, so lit parts of the same frame
# keep the normal bar. RTMO-s on COCO persons at 704x576: 0.50 / 0.45 gives
# precision 0.96 lit and 0.95 at -3 EV; a 0.35 dark threshold dropped dark
# precision to 0.91. Equal to PERSON_CONF_THRESHOLD = off.
# PERSON_CONF_THRESHOLD_DARK=0.45
# PERSON_DARK_LUMA=60

# Geometry gates that reject boxes which cannot be an upright person.
# A standing shopper is clearly taller than wide and occupies a modest part of
# the frame; without these a small model labels floor texture and shelving as
# people and those false positives become permanent "shoppers" in the data.
PERSON_MIN_ASPECT_RATIO=1.2
PERSON_MAX_FRAME_FRACTION=0.35
PERSON_MIN_BOX_PIXELS=24          # minimum box height
# Minimum box width. Separate from the height floor: a distant shopper on a
# 352x288 sub-stream is ~60 px tall but 16-24 px wide (a 24 px width floor
# rejected 31 real people for 3 false boxes in the evaluation).
PERSON_MIN_BOX_WIDTH_PIXELS=16

# Lighting is measured on every analysed frame (mean/percentiles of
# luminance, share of dark pixels, colour saturation; near-zero saturation =
# IR night mode) and reported per camera as day | mixed | low_light | ir,
# with hysteresis, never from the clock. LOW_LIGHT_ENHANCE applies CLAHE to
# the model input in non-day states (auto) or always; it is OFF by default
# because it lowered recall in every dark condition measured (it amplifies
# sensor noise and JPEG blocking). Kept for experiments and viewers.
# LOW_LIGHT_ENHANCE=off             # off | auto | always
# LOW_LIGHT_MEAN_LEVEL=70           # mean luma below -> low_light
# LOW_LIGHT_MIXED_DARK_FRACTION=0.30  # share of pixels below LOW_LIGHT_DARK_LEVEL -> mixed
# LOW_LIGHT_DARK_LEVEL=50
# LOW_LIGHT_IR_SATURATION=12        # mean saturation (0-255) below -> ir
# LOW_LIGHT_DEAD_BAND=0.15          # relative margin to leave the current state
# LOW_LIGHT_HYSTERESIS_FRAMES=5     # agreeing frames needed to switch
# LOW_LIGHT_CLAHE_CLIP=2.0
# LOW_LIGHT_CLAHE_TILES=8

# Run detection on at most every Nth frame. 5 at 25fps is 5 inferences/sec/
# camera, ample for footfall and dwell. With many cameras the accelerator
# cannot do that for all of them, so the scheduler shares it (below) and this
# becomes the per-camera ceiling.
ANALYTICS_DETECT_EVERY_N_FRAMES=5
# Global inference budget: plan for POSE_BUDGET_UTILISATION of the measured
# accelerator capacity and split it fairly between the cameras that analyse;
# every camera gets at least ANALYTICS_MIN_DETECT_FPS. The pose model (and the
# auto refiner, dropped first) is re-fitted so each camera can get
# ANALYTICS_TARGET_DETECT_FPS, ANALYTICS_REFIT_DEBOUNCE_SEC after cameras come
# or go. Target = floor favours the largest model over detection rate.
# "load_control" in /api/v1/layout/pipeline/status shows what really runs.
# ANALYTICS_SCHEDULER=1           # 0 = the old every-Nth-frame rule
# POSE_BUDGET_UTILISATION=0.6
# ANALYTICS_MIN_DETECT_FPS=1.0
# ANALYTICS_TARGET_DETECT_FPS=2.0
# ANALYTICS_REFIT_DEBOUNCE_SEC=30
# ANALYTICS_MAX_INFLIGHT=4        # analysed frames in flight; more = frame skipped
# FFmpeg decode threads per software-decoded camera. 0 = by
# resolution: 1 up to 720p, 2 up to 1080p, 4 above.
# CAMERA_DECODE_THREADS=0
# Camera video decoding on the GPU (needs the system ffmpeg binary). "auto"
# tests NVIDIA NVDEC, then VA-API (AMD / Intel render nodes) at start-up and
# uses the first that decodes a test clip correctly, else software (OpenCV on
# the CPU). A camera the GPU cannot decode falls back to software on its own;
# System health shows what each camera really uses. RTSP cameras only.
# DECODE_BACKEND=auto             # auto | cuda | vaapi | software
# DECODE_DEVICE=                  # e.g. /dev/dri/renderD129 or a CUDA index; empty = first that works
# At most this many frames a second per RTSP camera (0 = all): dropped on the
# GPU, or in software decoded but not converted to BGR. Analysis (~2-3 fps per
# camera) and the 5 fps clip ring never need more; the enlarged live view and
# Studio show at most this rate. 10 = smoother live view for ~1 % of a core
# per camera (store box: 8 test cameras 58 % at 5 fps, 67 % at 10).
# DECODE_MAX_FPS=5
# GPU-decoded frames wider than this are scaled down on the GPU before they
# are downloaded (0 = native; a camera's "decode_max_width" setting wins).
# auto = 1920 while the pose model takes a 544x960 input (it sees <= 960 px
# anyway; the same people were found at 1920 as at native), native while a
# 640x640 model runs (RTMO-s, the default: a 640x640 model found fewer far
# people on any scaled stream). A
# 2560x1440 camera at 1920: 24.5 -> 8 % of a core, 3072x2048: 39 -> 10 %.
# Calibrations, masks and zones need no redrawing (pixel geometry is scaled).
# Trade-off: evidence stills and clips of a scaled camera are 1920 px wide,
# not native; set the camera's decode_max_width to 0 for full-resolution
# evidence from it (at the higher CPU cost).
# DECODE_MAX_WIDTH=auto
# auto only: decode a camera on the GPU only if its stream has at least this
# many pixels (width x height), smaller ones in software. 0 = all on the GPU.
# On the store box the GPU path was cheaper or equal at every size measured
# (352x288 .. 3072x2048), hence 0; e.g. 921600 = GPU from 1280x720 up.
# Stream sizes are remembered in STORAGE_DIR/decode_stream_sizes.json.
# DECODE_GPU_MIN_PIXELS=0
# OpenCV's own thread pool. Each camera already has its own thread; the pool
# (one spinning thread per CPU by default) only added load: 8 test cameras
# 188 % of a core with it, 97 % with 1. 0 = OpenCV's default.
# OPENCV_THREADS=1
# Stream quality "Auto" (per camera, the default): analyse the smallest Dahua
# sub-stream (subtype 1 or 2) of at least D1 (704x576), else keep the current
# sub-stream; the main stream is never chosen automatically. Sub-stream sizes
# are measured once per camera (one frame, read-only), one camera at a time,
# starting STREAM_AUTO_SELECT_DELAY_S after start-up. 0 = do not measure
# automatically (re-measure from a camera's Settings instead).
# STREAM_AUTO_SELECT=1
# STREAM_AUTO_SELECT_DELAY_S=90
# Pre-event clip ring (JPEG-encoding ~5 frames/s per camera, was ~27 % of the
# camera threads' CPU). auto: only for cameras whose armed night watch saves
# clips (NIGHT_WATCH_CLIP); a clip exported by an operator then starts when
# it is asked for (post-roll only). on: every camera (5 s of pre-event
# footage in every clip). off: never.
# CLIP_PRE_EVENT_BUFFER=auto
TRACK_MAX_AGE_FRAMES=30
TRACK_MIN_HITS=3
# Time in a zone before it counts as dwell rather than walking past.
ZONE_DWELL_MIN_SECONDS=3.0

# --- Store time zone -----------------------------------------------------
# IANA name of the store's zone. "Today", hourly curves, restricted-area and
# night-watch schedules and alert times are store-local, DST included (from
# the zone database, never a fixed offset). Empty = this host's own zone.
# SITE_TIMEZONE=Australia/Melbourne

# --- Night watch (per camera: Settings > camera > Night watch) -----------
# While a camera's night watch is armed (its schedule, in store time, and
# optionally whenever the camera is in IR / low light) and nothing moves, the
# pose model does not run for it and its share of the GPU goes to the other
# cameras. A cheap motion check on a small grayscale copy runs instead;
# motion starts a short person-detection burst. A person -> NIGHT_INTRUSION
# (HIGH, dashboard + phones); motion with nobody -> NIGHT_MOTION (INFO,
# dashboard only). Measured ~2 ms of one CPU core per sample at any camera size.
# NIGHT_WATCH_MOTION_FPS=4               # motion samples per second per armed camera
# NIGHT_WATCH_MOTION_WIDTH=320           # width of the grayscale copy (px)
# NIGHT_WATCH_LIGHTING_FRACTION=0.45     # more of the picture changing at once = lighting, not motion
# NIGHT_WATCH_CONFIRM_SEC=4              # person detection after motion (at the camera's full rate)
# NIGHT_WATCH_CONFIRM_HITS=2             # frames with a person near the movement to alert
# NIGHT_WATCH_RECONFIRM_SEC=10           # after a burst found nobody, wait this long before another
# NIGHT_WATCH_MAX_EVENTS_PER_HOUR=12     # per camera; more are counted as suppressed, not recorded
# NIGHT_WATCH_CLIP=false                 # also save a short clip (pre-event buffer + post seconds)
# NIGHT_WATCH_CLIP_POST_SEC=5
# NIGHT_WATCH_EVIDENCE_DIR=              # empty = <STORAGE_DIR>/night_watch (this device's SSD)
# NIGHT_WATCH_EVIDENCE_MAX_MB=1024       # oldest deleted first above this (inside EVIDENCE_MAX_GB)

# --- Storage & retention ------------------------------------------------
# Defaults to <project>/storage on this device's SSD. Keep it there: the store
# NAS does the continuous recording and this software must never write to it.
# STORAGE_DIR=/opt/edge-cctv/storage
# No continuous recording on this device. It keeps only loss-prevention
# evidence (a still per alert, optionally a short clip) under STORAGE_DIR
# (theft_evidence/, zone_alerts/, night_watch/, snapshots/, clips/). The
# oldest files, across all of those, are deleted automatically when any
# limit below is passed; the alert then shows "evidence expired". If
# STORAGE_DIR is on a network share (NFS/SMB/SSHFS) nothing is deleted and
# health reports the error. dvr/, archives/ and recordings/ are never
# cleaned automatically.
STORAGE_RETENTION_DAYS=7                 # delete evidence older than this (0 = no age limit)
STORAGE_MAX_DISK_PERCENT=85.0            # also trim evidence so the disk stays below this
# EVIDENCE_MAX_GB=0                      # total evidence limit; 0 = automatic (10% of the disk, 1-50 GB)
# EVIDENCE_CLEANUP_INTERVAL_SEC=900      # background check interval (also checked after each save)

# --- Local model (business analysis narration) --------------------------
# Optional. Findings are produced by deterministic rules and stand on their
# own; the model only writes the executive summary over them.
OLLAMA_BASE_URL=http://localhost:11434

# --- Network -------------------------------------------------------------
# Address uvicorn listens on (deploy/edge-cctv.service, entrypoint.sh and
# run.sh read it). 0.0.0.0 = every interface: the store LAN and a VPN such as
# Tailscale reach plain http://<ip>:PORT. HOST=127.0.0.1 closes the
# unencrypted port to the network entirely; the VPS tunnel (frpc) still
# works, as it connects over loopback. Online access needs 0.0.0.0 or
# 127.0.0.1 (docs/DEPLOYMENT.md, "Online access").
# X-Forwarded-For/-Proto are believed only from 127.0.0.1/::1 (the tunnel
# client or another local proxy), whatever HOST is.
HOST=0.0.0.0
PORT=8000
