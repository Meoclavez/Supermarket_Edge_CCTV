# Edge AI CCTV — Production Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Security ──────────────────────────────────────────────────
# JWT signing key for mobile app tokens. CHANGE THIS in production!
JWT_SECRET=your_random_64_char_hex_string_here

# Internal API key for backend-to-backend calls (event triggers, health checks)
INTERNAL_SERVICE_KEY=edge_ai_vision_internal_secret

# ── TURN / WebRTC (Coturn) ────────────────────────────────────
# Shared HMAC-SHA1 secret — MUST match between edge_api and coturn.
# This single value is injected into BOTH services automatically.
COTURN_SECRET=cctv_turn_super_secret_dynamic_key_change_me_in_prod

# Your Mini PC's LAN IP or public IP (used in ICE candidates)
COTURN_PUBLIC_IP=192.168.1.100

# ── Push Notifications ────────────────────────────────────────
# Android: Firebase Cloud Messaging server key
FCM_SERVER_KEY=

# iOS: Apple Push Notification Service credentials
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.cctv.edgeAiCctv

# ── VPN (Optional) ───────────────────────────────────────────
# Tailscale auth key for zero-trust remote access
TS_AUTHKEY=
