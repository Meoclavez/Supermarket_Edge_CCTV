# Edge AI CCTV -- deployment configuration.
#
# Copy to `.env` beside the application and edit. Every value below has a
# working default; the ones marked REQUIRED must be changed before the system
# is exposed on a store network.

# --- Security -----------------------------------------------------------
# REQUIRED. DEBUG=true disables authentication entirely on every API route.
# It exists for local development only and must be false in a store.
DEBUG=false

# REQUIRED. Signs session tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Leaving the default lets anyone mint a valid session for this store.
JWT_SECRET=CHANGE_ME_BEFORE_DEPLOYMENT

# REQUIRED. Shared key for machine-to-machine calls (mobile app, POS bridge).
INTERNAL_SERVICE_KEY=CHANGE_ME_BEFORE_DEPLOYMENT

# Restrict to the addresses that actually serve the dashboard.
# "*" is acceptable only on an isolated VLAN with no internet route.
ALLOWED_CORS_ORIGINS=["http://localhost:8000"]

# --- Store identity -----------------------------------------------------
STORE_ID=store_main
STORE_NAME=Your Store Name
# Starting blueprint extent in metres; editable later in the dashboard.
DEFAULT_STORE_WIDTH_M=50.0
DEFAULT_STORE_HEIGHT_M=30.0

# --- Person detection ---------------------------------------------------
# The accelerator is auto-detected at startup (Hailo -> TensorRT -> CUDA ->
# ROCm -> OpenVINO -> CPU). Nothing here selects hardware; install
# onnxruntime-gpu on a machine with a dedicated GPU and it is picked up.
PERSON_MODEL_PATH=./models/yolov5n.onnx

# Raise if the store reports people who are not there; lower if real shoppers
# are missed. Tune against real footage, not a guess.
PERSON_CONF_THRESHOLD=0.50

# Geometry gates that reject boxes which cannot be an upright person.
# A standing shopper is clearly taller than wide and occupies a modest part of
# the frame; without these a small model labels floor texture and shelving as
# people and those false positives become permanent "shoppers" in the data.
PERSON_MIN_ASPECT_RATIO=1.2
PERSON_MAX_FRAME_FRACTION=0.35
PERSON_MIN_BOX_PIXELS=24

# Run detection on every Nth frame. 5 at 25fps is 5 inferences/sec/camera,
# ample for footfall and dwell. Lower it only if people are missed entirely.
ANALYTICS_DETECT_EVERY_N_FRAMES=5
TRACK_MAX_AGE_FRAMES=30
TRACK_MIN_HITS=3
# Time in a zone before it counts as dwell rather than walking past.
ZONE_DWELL_MIN_SECONDS=3.0

# --- Storage & retention ------------------------------------------------
# Defaults to <project>/storage. Point at the NAS mount in a real deployment.
# STORAGE_DIR=/mnt/nas/cctv
STORAGE_RETENTION_DAYS=7
STORAGE_MAX_DISK_PERCENT=85.0

# --- Local model (business analysis narration) --------------------------
# Optional. Findings are produced by deterministic rules and stand on their
# own; the model only writes the executive summary over them.
OLLAMA_BASE_URL=http://localhost:11434

# --- Network -------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
